# ─────────────────────────────────────────────────────────────────────────────
# soccer2026 backend configuration.
# Copy this file to `.env` and fill in the values you need:
#     cp .env.example .env
# Everything here has a sensible default, so the app runs with an empty .env —
# the only thing you need for LIVE scores is FOOTBALLDATA_API_KEY (see below).
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────────────────────
# These match docker-compose.yml. Only change them if your DB runs elsewhere.
PGHOST=localhost
PGPORT=5433
PGUSER=soccer_admin
PGPASSWORD=soccer2026
PGDATABASE=soccer2026

# ── API server ──────────────────────────────────────────────────────────────
# Port the FastAPI backend listens on (the Vite client proxies /api to it).
PORT=4000

# ── Local AI (Ollama) ───────────────────────────────────────────────────────
# Powers the natural-language chat and the Rules Q&A. All local — no cloud keys.
# If Ollama is not running, chat falls back to a rule-based interpreter and the
# Rules Q&A falls back to TF-IDF retrieval, so the app still works.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT_MS=30000

# ── Live match data (footballdata.io) ───────────────────────────────────────
# OPTIONAL. Without a key, the Overview tab is served from the local Postgres
# database (works fully offline). With a key, /api/overview pulls real-time
# WC2026 scores from footballdata.io and falls back to the DB on any error.
# Get a free key at https://footballdata.io/ and paste it below.
FOOTBALLDATA_API_KEY=
FOOTBALLDATA_LEAGUE_ID=50
FOOTBALLDATA_SEASON_ID=618
FOOTBALLDATA_TTL=120
FOOTBALLDATA_LIVE_WINDOW_MIN=180
